@{
    ViewData["Title"] = "Hakkımızda";
}

<!-- Banner Start -->
<section class="section banner-about pb-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-10">
                <h1 class="cd-headline clip is-full-width mb-4">
                    İş ortaklarımız için <br>
                    <span class="cd-words-wrapper text-color" aria-live="polite">
                        <b class="is-visible">marka kimliği</b>
                        <b>tasarım çözümleri</b>
                        <b>dijital stratejiler</b>
                    </span>
                    <br>inşa ediyoruz
                </h1>
                <p class="mb-5 lead-text">Modern web standartlarına tam uyumlu, estetik ve yüksek performanslı dijital deneyimler
                    geliştiriyoruz. <strong>Nascore</strong> olarak, işletmenizin kurumsal vizyonunu yenilikçi
                    teknolojiler ve yaratıcı tasarım disipliniyle geleceğe taşıyoruz.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4" data-aos="fade-up">
                <h3 class="h4">Modern Tasarım</h3>
                <p>Kullanıcı deneyimini merkeze alan, estetik ve işlevselliği buluşturan çağdaş arayüzler tasarlıyoruz.</p>
            </div>

            <div class="col-lg-4 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="150">
                <h3 class="h4">Temiz & Güçlü Kod</h3>
                <p>En güncel teknolojilerle geliştirilmiş, ölçeklenebilir, güvenli ve sürdürülebilir yazılım mimarileri kuruyoruz.</p>
            </div>

            <div class="col-lg-4 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="300">
                <h3 class="h4">Tam Uyumlu (Responsive)</h3>
                <p>Mobil, tablet ve masaüstü tüm ekranlarda kusursuz çalışan, yüksek hızlı ve duyarlı deneyimler sunuyoruz.</p>
            </div>
        </div>
    </div>
</section>
<!-- Banner End -->

<!-- Service start -->
<section class="section service-home border-top">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <h2 class="mb-2">Temel Hizmetlerimiz.</h2>
                <p class="mb-5">Fikirden nihai ürüne kadar markanızın tüm dijital dönüşüm süreçlerinde uçtan uca,
                    yenilikçi ve sonuç odaklı çözümler üretiyoruz.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-4 col-md-6 mb-5">
                <div class="service-item" data-aos="fade-up">
                    <i class="ti-layout" aria-hidden="true"></i>
                    <div class="service-content">
                        <h3 class="h4 mb-3">Web Geliştirme</h3>
                        <p class="mb-0">Hızlı, güvenli ve modern web uygulamaları ile markanızı dijital dünyada bir adım öne çıkarıyoruz.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-5">
                <div class="service-item" data-aos="fade-up" data-aos-delay="100">
                    <i class="ti-announcement" aria-hidden="true"></i>
                    <div class="service-content">
                        <h3 class="h4 mb-3">Dijital Pazarlama</h3>
                        <p class="mb-0">Veriye dayalı stratejilerle hedef kitlenize doğrudan ulaşın, dönüşüm oranlarınızı ve marka bilinirliğinizi artırın.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-5">
                <div class="service-item" data-aos="fade-up" data-aos-delay="200">
                    <i class="ti-layers" aria-hidden="true"></i>
                    <div class="service-content">
                        <h3 class="h4 mb-3">Grafik & Görsel Tasarım</h3>
                        <p class="mb-0">Markanızın karakterini yansıtan, akılda kalıcı ve etkileyici görsel kimlik unsurları oluşturuyoruz.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-5">
                <div class="service-item" data-aos="fade-up" data-aos-delay="100">
                    <i class="ti-bookmark" aria-hidden="true"></i>
                    <div class="service-content">
                        <h3 class="h4 mb-3">Marka Kimliği (Branding)</h3>
                        <p class="mb-0">Logo tasarımından kurumsal kimlik rehberine kadar markanızı benzersiz kılacak bütünsel çözümler sunuyoruz.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-5">
                <div class="service-item" data-aos="fade-up" data-aos-delay="200">
                    <i class="ti-video-camera" aria-hidden="true"></i>
                    <div class="service-content">
                        <h3 class="h4 mb-3">Video & Prodüksiyon</h3>
                        <p class="mb-0">Marka hikayenizi etkili animasyonlar ve dinamik video içeriklerle görsel bir şölene dönüştürüyoruz.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-5">
                <div class="service-item" data-aos="fade-up" data-aos-delay="300">
                    <i class="ti-mobile" aria-hidden="true"></i>
                    <div class="service-content">
                        <h3 class="h4 mb-3">Mobil & Uygulama Tasarımı</h3>
                        <p class="mb-0">Kullanıcı alışkanlıklarına odaklanan, modern ve akıcı mobil arayüz (UI/UX) deneyimleri inşa ediyoruz.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Service end -->

<!-- About / Skills Section Start -->
<section class="section skills-section border-top border-bottom py-5">
    <div class="container">
        <div class="row align-items-center">
            <!-- Estetik Görsel Alanı -->
            <div class="col-lg-6 pr-lg-5 mb-5 mb-lg-0">
                <div class="about-image-card-wrapper">
                    <div class="about-glow-backdrop"></div>
                    <div class="about-image-container">
                        <img src="~/user-interface/images/about-img.jpg" alt="Nascore Yetkinlikler ve Strateji"
                             class="img-fluid about-main-img" loading="lazy" decoding="async">
                    </div>
                </div>
            </div>

            <!-- İlerleme Çubukları (Progress Bars) -->
            <div class="col-lg-6 pl-lg-4">
                <div class="modern-progress-wrapper">
                    <!-- 1. Progress Bar -->
                    <div class="modern-progress-item">
                        <div class="progress-info-row d-flex align-items-center justify-content-between mb-2">
                            <span class="progress-name">İş & Marka Stratejisi</span>
                            <span class="progress-badge">0%</span>
                        </div>
                        <div class="modern-progress-track">
                            <div class="modern-progress-fill" data-percent="80" style="width: 0%;" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="İş ve Marka Stratejisi Yetkinlik Oranı"></div>
                        </div>
                    </div>

                    <!-- 2. Progress Bar -->
                    <div class="modern-progress-item">
                        <div class="progress-info-row d-flex align-items-center justify-content-between mb-2">
                            <span class="progress-name">UI / UX & Arayüz Tasarımı</span>
                            <span class="progress-badge">0%</span>
                        </div>
                        <div class="modern-progress-track">
                            <div class="modern-progress-fill" data-percent="90" style="width: 0%;" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="UI ve UX Arayüz Tasarımı Yetkinlik Oranı"></div>
                        </div>
                    </div>

                    <!-- 3. Progress Bar -->
                    <div class="modern-progress-item">
                        <div class="progress-info-row d-flex align-items-center justify-content-between mb-2">
                            <span class="progress-name">Dijital Büyüme & Pazarlama</span>
                            <span class="progress-badge">0%</span>
                        </div>
                        <div class="modern-progress-track">
                            <div class="modern-progress-fill" data-percent="75" style="width: 0%;" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Dijital Büyüme ve Pazarlama Yetkinlik Oranı"></div>
                        </div>
                    </div>

                    <!-- 4. Progress Bar -->
                    <div class="modern-progress-item">
                        <div class="progress-info-row d-flex align-items-center justify-content-between mb-2">
                            <span class="progress-name">Web & Yazılım Geliştirme</span>
                            <span class="progress-badge">0%</span>
                        </div>
                        <div class="modern-progress-track">
                            <div class="modern-progress-fill" data-percent="85" style="width: 0%;" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Web ve Yazılım Geliştirme Yetkinlik Oranı"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- About / Skills Section End -->

    <!-- Testimonials Section (Modern Swiper Multi-Card Slider) -->
    <section id="testimonials" class="testimonials-section section py-5">
        <!-- Section Header -->
        <div class="container text-center section-header" data-aos="fade-up">
            <h2 class="mt-2 font-weight-bold">İş Ortaklarımız Ne Diyor?</h2>
            <p>Birlikte başarı hikayeleri yazdığımız değerli markaların Nascore hakkındaki samimi değerlendirmeleri.</p>
        </div>

        <div class="container" data-aos="fade-up" data-aos-delay="100">
            <div class="swiper testimonials-swiper">
                <div class="swiper-wrapper">

                    <!-- Kart 1 -->
                    <div class="swiper-slide">
                        <div class="testimonial-card-item">
                            <div class="testimonial-card-header">
                                <img src="~/user-interface/images/blog/author1.jpg" class="testimonial-card-avatar" alt="Caner Yılmaz">
                                <div class="testimonial-card-info">
                                    <h3>Caner Yılmaz</h3>
                                    <h4>Genel Müdür &bull; Nova Teknoloji</h4>
                                </div>
                            </div>
                            <div class="testimonial-card-stars">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                            <div class="testimonial-card-body">
                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>Nascore ekibiyle çalışmak kurumsal dijital dönüşüm sürecimizde aldığımız en doğru karardı. Hem kullanıcı deneyimi odaklı yaklaşımları hem de teslimat hızları beklentilerimizin çok ötesindeydi.</span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Kart 2 -->
                    <div class="swiper-slide">
                        <div class="testimonial-card-item">
                            <div class="testimonial-card-header">
                                <img src="~/user-interface/images/blog/author2.jpg" class="testimonial-card-avatar" alt="Selin Aktaş">
                                <div class="testimonial-card-info">
                                    <h3>Selin Aktaş</h3>
                                    <h4>Pazarlama Direktörü &bull; Apex Retail</h4>
                                </div>
                            </div>
                            <div class="testimonial-card-stars">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                            <div class="testimonial-card-body">
                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>Marka kimliğimizin ve e-ticaret altyapımızın yenilenmesinde gösterdikleri titizlik ve teknik uzmanlık sayesinde ilk 3 ayda %65'lik somut bir ciro artışı yakaladık.</span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Kart 3 -->
                    <div class="swiper-slide">
                        <div class="testimonial-card-item">
                            <div class="testimonial-card-header">
                                <img src="~/user-interface/images/blog/author3.jpg" class="testimonial-card-avatar" alt="Murat Demir">
                                <div class="testimonial-card-info">
                                    <h3>Murat Demir</h3>
                                    <h4>Kurucu Ortak &bull; Finova Yazılım</h4>
                                </div>
                            </div>
                            <div class="testimonial-card-stars">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                            <div class="testimonial-card-body">
                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>Sadece bir ajans değil, projenin her aşamasında bizimle aynı heyecanı paylaşan gerçek bir teknoloji ortağı oldular. Satış sonrası 7/24 kesintisiz destek için minnettarız.</span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Kart 4 -->
                    <div class="swiper-slide">
                        <div class="testimonial-card-item">
                            <div class="testimonial-card-header">
                                <img src="~/user-interface/images/profile.jpg" class="testimonial-card-avatar" alt="Burak Eren">
                                <div class="testimonial-card-info">
                                    <h3>Burak Eren</h3>
                                    <h4>Ürün Yöneticisi &bull; LogiTech Global</h4>
                                </div>
                            </div>
                            <div class="testimonial-card-stars">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                            <div class="testimonial-card-body">
                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>Geliştirdikleri yüksek performanslı web arayüzü ve modern kod mimarisi sayesinde sayfa açılış hızlarımız iki katına çıktı. Ekibin profesyonelliği takdire şayan.</span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Kart 5 -->
                    <div class="swiper-slide">
                        <div class="testimonial-card-item">
                            <div class="testimonial-card-header">
                                <img src="~/user-interface/images/profile.jpg" class="testimonial-card-avatar" alt="Ece Soylu" loading="lazy" decoding="async">
                                <div class="testimonial-card-info">
                                    <h3>Ece Soylu</h3>
                                    <h4>Kreatif Direktör &bull; Studio Pulse</h4>
                                </div>
                            </div>
                            <div class="testimonial-card-stars">
                                <i class="bi bi-star-fill" aria-hidden="true"></i>
                                <i class="bi bi-star-fill" aria-hidden="true"></i>
                                <i class="bi bi-star-fill" aria-hidden="true"></i>
                                <i class="bi bi-star-fill" aria-hidden="true"></i>
                                <i class="bi bi-star-fill" aria-hidden="true"></i>
                            </div>
                            <div class="testimonial-card-body">
                                <p>
                                    <i class="bi bi-quote quote-icon-left" aria-hidden="true"></i>
                                    <span>Tasarım vizyonumuzu tam olarak anlayıp beklentilerimizin bile ötesinde bir görsel estetik sundular. Markamızın prestijini bambaşka bir seviyeye taşıdılar.</span>
                                    <i class="bi bi-quote quote-icon-right" aria-hidden="true"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- Pagination Dots -->
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </section>
    <!-- /Testimonials Section -->


   
