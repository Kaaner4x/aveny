                                        <span class="category text-sm">Teknoloji</span>
                                    </div>
                                    <a asp-controller="News" asp-action="Detail" asp-route-id="2">
                                        <h3 class="h4">Modern web ve tasarım trendlerinde öne çıkan yenilikler.</h3>
                                    </a>
