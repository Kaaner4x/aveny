<!-- Banner Start -->
<section class="section banner pb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h2 class="cd-headline clip is-full-width mb-4">
                    Markanız İçin <br>
                    <span class="cd-words-wrapper text-color">
                        <b class="is-visible">Tasarım Çözümleri.</b>
                        <b>Yaratıcı Fikirler.</b>
                        <b>Dijital Deneyimler.</b>
                        <b>Profesyonel İçerikler.</b>
                    </span>
                </h2>
                <p class="lead-text mb-4">Modern web teknolojileri ve özgün tasarım anlayışıyla işletmenizin dijital dünyadaki varlığını güçlendiriyor, markanızı hedef kitlenizle en etkili şekilde buluşturuyoruz.</p>
                <div class="banner-buttons d-flex flex-wrap align-items-center">
                    <a href="#haberler" class="btn btn-hero-primary mr-3 mb-2">
                        Projelerimizi İnceleyin <i class="ti-arrow-right ml-2"></i>
                    </a>
                    <a href="#" class="btn btn-hero-secondary mb-2">
                        İletişime Geçin
                    </a>
                </div>
            </div>

            <div class="col-lg-5 mt-5 mt-lg-0 text-center">
                <div class="hero-image-wrapper">
                    <img src="~/user-interface/images/home-2.jpg" alt="Nascore Dijital Çözümler" class="img-fluid hero-img">
                    <div class="hero-floating-badge">
                        <div class="badge-icon">
                            <i class="ti-check"></i>
                        </div>
                        <div class="badge-content text-left">
                            <strong>%100 Memnuniyet</strong>
                            <span>Özgün & Profesyonel</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Banner End -->

