                                        <img src="~/user-interface/images/blog/minimal-1.jpg" alt="Yeni projeler ve sektörel gelişmeler hakkında duyuru görseli" class="img-fluid" loading="lazy" decoding="async">
                                    </a>
                                </div>
                                <div class="post-content">
                                    <div class="post-meta">
                                        <span class="date text-sm"><i class="ti-calendar mr-1" aria-hidden="true"></i>17 Haziran 2024</span>
                                        <span class="meta-dot" aria-hidden="true">•</span>
                                        <span class="category text-sm">Tasarım</span>
                                    </div>
                                    <a asp-controller="News" asp-action="Detail" asp-route-id="1">
                                        <h3 class="h4">Yeni projeler ve sektörel gelişmeler hakkında önemli duyurular.</h3>
