@{
    ViewData["Title"] = "Haber Detayı";
}

<!-- Sayfa Başlığı Start -->
<section class="page-title section pt-5 pb-0">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="text-center">
          <h1 class="text-capitalize mb-0 text-lg">Haber Detayı</h1>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Sayfa Başlığı End -->

<section class="section blog-post pt-4">
	<div class="container">
		<div class="row">
			<div class="col-lg-8">
				<article class="single-post">
					<img src="~/user-interface/images/blog/01.jpg" alt="Haber Görseli" class="img-fluid w-100 rounded">

					<div class="single-post-content mt-4">
						<div class="post-meta mb-4">
							<span class="text-black font-weight-bold">Kategori :</span>
							<span class="text-color">Tasarım, Teknoloji</span>
							<span class="mx-3">•</span>
							<span class="date text-muted"><i class="ti-calendar mr-1"></i>17 Haziran 2024</span>
						</div>
						
						<h3 class="mb-3">Yeni Projeler ve Sektörel Gelişmeler Hakkında Önemli Duyurular</h3>

						<p class="lead-text mb-4">Modern web teknolojileri ve dijital dönüşüm süreçleri, işletmelerin marka değerini artırmada en kritik unsurlardan biri haline gelmiştir. Kullanıcı deneyimini merkeze alan tasarımlarımızla projelerinize güç katıyoruz.</p>

						<h5>Etkili Kullanıcı Deneyimi ve Yaratıcı Çözümler</h5>
						<p>Başarılı bir dijital varlık inşa etmek, yalnızca estetik bir görünümden ibaret değildir; aynı zamanda yüksek hız, mobil uyumluluk ve kesintisiz bir kullanıcı yolculuğu gerektirir. Nascore ekibi olarak, her projede en güncel yazılım standartlarını ve yenilikçi tasarım ilkelerini bir araya getiriyoruz.</p>

						<p>İşletmenizin ihtiyaçlarına özel olarak geliştirilen çözümlerimiz sayesinde hem ziyaretçileriniz için unutulmaz bir deneyim sunabilir hem de hedeflerinize çok daha hızlı ulaşabilirsiniz.</p>

						<!-- Paylaşım Bölümü -->
						<div class="share mt-5 pt-4 border-top">
							<ul class="list-inline d-flex align-items-center mb-0">
								<li class="mr-3 font-weight-bold text-dark">Paylaş:</li>
								<li class="list-inline-item mr-3"><a href="https://facebook.com" target="_blank" class="text-muted"><i class="ti-facebook mr-1"></i> Facebook</a></li>
								<li class="list-inline-item mr-3"><a href="https://twitter.com" target="_blank" class="text-muted"><i class="ti-twitter mr-1"></i> Twitter</a></li>
								<li class="list-inline-item mr-3"><a href="https://linkedin.com" target="_blank" class="text-muted"><i class="ti-linkedin mr-1"></i> LinkedIn</a></li>
								<li class="list-inline-item"><a href="https://pinterest.com" target="_blank" class="text-muted"><i class="ti-pinterest mr-1"></i> Pinterest</a></li>
							</ul>
						</div>	
					</div>
				</article>
			</div>

