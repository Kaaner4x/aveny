<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nascore - Yenilikçi dijital stratejiler, modern web geliştirme ve kullanıcı odaklı UI/UX tasarım stüdyosu." />
    <meta name="theme-color" content="#007aff" />
    <title>@ViewData["Title"] - Nascore</title>

    <!-- Google Fonts Preconnect & Stylesheet (Plus Jakarta Sans & Inter with complete Turkish Latin-Ext support) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Plugins Needed for the Project -->
    <link rel="stylesheet" href="~/user-interface/plugins/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/user-interface/plugins/themify/css/themify-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/user-interface/plugins/counto/animate.css" />
    <link rel="stylesheet" href="~/user-interface/plugins/aos/aos.css" />
    <link rel="stylesheet" href="~/user-interface/plugins/owl-carousel/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/user-interface/plugins/owl-carousel/owl.theme.default.min.css" />
    <link rel="stylesheet" href="~/user-interface/plugins/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/user-interface/plugins/animated-text/animated-text.css" />

    <!-- Main Stylesheet -->
    <link rel="stylesheet" href="~/user-interface/css/style.css" asp-append-version="true" />
</head>

<body>

    <header>
        <!-- Header Top Bar (Minimal Style) -->
        <div class="header-top-bar">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-7 col-12 text-center text-md-left">
                        <ul class="list-inline mb-0 top-contact-info">
                            <li class="list-inline-item mr-3">
                                <a href="tel:+902125550123" aria-label="Telefon: +90 212 555 01 23">
                                    <i class="ti-mobile mr-1" aria-hidden="true"></i>+90 (212) 555 01 23
                                </a>
                            </li>
                            <li class="list-inline-item">
                                <a href="mailto:info@nascore.com" aria-label="E-Posta: info@nascore.com">
                                    <i class="ti-email mr-1" aria-hidden="true"></i>info@nascore.com
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-5 col-12 text-center text-md-right d-none d-md-block">
                        <ul class="list-inline mb-0 top-social-links">
                            <li class="list-inline-item"><a href="#!" title="LinkedIn" aria-label="Nascore LinkedIn"><i class="ti-linkedin" aria-hidden="true"></i></a></li>
                            <li class="list-inline-item"><a href="#!" title="Instagram" aria-label="Nascore Instagram"><i class="ti-instagram" aria-hidden="true"></i></a></li>
                            <li class="list-inline-item"><a href="#!" title="Twitter" aria-label="Nascore Twitter"><i class="ti-twitter-alt" aria-hidden="true"></i></a></li>
                            <li class="list-inline-item"><a href="#!" title="GitHub" aria-label="Nascore GitHub"><i class="ti-github" aria-hidden="true"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg  main-nav " id="navbar">
            <div class="container">
                <a class="navbar-brand brand-bukra-logo" asp-controller="Home" asp-action="Index">
                    <img src="~/items/logo/nascore-text.svg" alt="Nascore" class="img-fluid bukra-logo-img">
                </a>

                <button class="navbar-toggler collapsed" type="button" data-toggle="collapse"
                        data-target="#navbarsExample09" aria-controls="navbarsExample09" aria-expanded="false"
                        aria-label="Menüyü Aç/Kapat">
                    <span class="ti-menu"></span>
                </button>

                @{
                    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
                }

                <div class="collapse navbar-collapse" id="navbarsExample09">
                    <ul class="navbar-nav ml-auto">
                        <!-- Ana Sayfa -->
                        <li class="nav-item @(currentCtrl.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        <!-- Hakkımızda -->
                        <li class="nav-item @(currentCtrl.Equals("About", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" asp-controller="About" asp-action="Index">Hakkımızda</a>
                        </li>

                        <!-- Projelerimiz -->
                        <li class="nav-item @(currentCtrl.Equals("Project", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" asp-controller="Project" asp-action="Index">Projelerimiz</a>
                        </li>
                            
                        <!-- İletişim -->
                        <li class="nav-item @(currentCtrl.Equals("Contact", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">İletişim</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <!-- Footer start -->
        <footer class="footer">
            <div class="container">
                <div class="row ">
                    <div class="col-lg-6">
                        <p class="mb-0 text-white">
                            © @DateTime.Now.Year <strong>Nascore</strong> - Tüm hakları saklıdır. <br>
                            <small class="text-white-50">
                                Tasarım Altyapısı: <a target="_blank" rel="noopener noreferrer" href="https://themefisher.com"
                                                      class="text-white-50">Themefisher</a> & <a target="_blank" rel="noopener noreferrer" href="https://themewagon.com"
                                                                           class="text-white-50">ThemeWagon</a>
                            </small>
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <div class="widget footer-widget text-lg-right mt-5 mt-lg-0">
                            <ul class="list-inline mb-0">
                                <li class="list-inline-item"><a href="https://facebook.com" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook Sayfası"><i
                                    class="ti-facebook mr-3" aria-hidden="true"></i></a></li>
                                <li class="list-inline-item"><a href="https://twitter.com" target="_blank" rel="noopener noreferrer" title="Twitter" aria-label="Twitter Profili"><i
                                    class="ti-twitter mr-3" aria-hidden="true"></i></a></li>
                                <li class="list-inline-item"><a href="https://github.com" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub Profili"><i class="ti-github mr-3" aria-hidden="true"></i></a>
                                </li>
                                <li class="list-inline-item"><a href="https://pinterest.com" target="_blank" rel="noopener noreferrer" title="Pinterest" aria-label="Pinterest Profili"><i
                                    class="ti-pinterest mr-3" aria-hidden="true"></i></a></li>
                                <li class="list-inline-item"><a href="https://dribbble.com" target="_blank" rel="noopener noreferrer" title="Dribbble" aria-label="Dribbble Profili"><i
                                    class="ti-dribbble mr-3" aria-hidden="true"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- Footer End -->

        <!-- jQuery -->
        <script src="~/user-interface/plugins/jQuery/jquery.min.js"></script>

        <!-- Bootstrap JS -->
        <script src="~/user-interface/plugins/bootstrap/bootstrap.min.js"></script>
        <script src="~/user-interface/plugins/aos/aos.js"></script>
        <script src="~/user-interface/plugins/owl-carousel/owl.carousel.min.js"></script>
        <script src="~/user-interface/plugins/shuffle/shuffle.min.js"></script>
        <script src="~/user-interface/plugins/magnific-popup/jquery.magnific-popup.min.js"></script>
        <script src="~/user-interface/plugins/animated-text/animated-text.js"></script>
        <script src="~/user-interface/plugins/counto/apear.js"></script>
        <script src="~/user-interface/plugins/counto/counTo.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

        <!-- Main Script -->
        <script src="~/user-interface/js/nascore.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
